        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n  class Project {\n    +string id\n    +string name\n    +string createdDate\n    +string status\n    +createFolderStructure()\n    +addMember(User, role)\n    +currentPhase() PhaseProgress\n  }\n\n  class User {\n    +string id\n    +string name\n    +string email\n    +string globalRole\n  }\n\n  class ProjectMember {\n    +string id\n    +string role\n  }\n\n  class Phase {\n    +string id\n    +string name\n    +int orderIndex\n  }\n\n  class PhaseProgress {\n    +string id\n    +string status\n    +string startedAt\n    +string completedAt\n    +advance()\n    +checkGate() bool\n  }\n\n  class ChecklistCategory {\n    +string id\n    +string name\n  }\n\n  class ChecklistItem {\n    +string id\n    +string description\n    +bool isComplete\n    +markComplete()\n    +markIncomplete()\n  }\n\n  class FolderType {\n    +string id\n    +string name\n  }\n\n  class Folder {\n    +string id\n    +string path\n    +createOnDisk()\n  }\n\n  class Asset {\n    &lt;&lt;abstract&gt;&gt;\n    +string id\n    +string filename\n    +string version\n    +string dateAdded\n    +int rating\n    +setRating(int rating)\n    +getAssetType() string\n  }\n\n  class VideoAsset {\n    +int durationSeconds\n    +getAssetType() string\n  }\n\n  class AudioAsset {\n    +bool levelsOk\n    +getAssetType() string\n  }\n\n  class GraphicAsset {\n    +string dimensions\n    +getAssetType() string\n  }\n\n  class AudioTrack {\n    +string id\n    +string trackType\n    +bool levelsOk\n    +checkLevels()\n  }\n\n  class Platform {\n    +string id\n    +string name\n  }\n\n  class ExportPreset {\n    +string id\n    +string resolution\n    +string framerate\n    +string codec\n    +apply()\n  }\n\n  class Export {\n    +string id\n    +string exportDate\n    +string filePath\n    +render()\n  }\n\n  Asset &lt;|-- VideoAsset\n  Asset &lt;|-- AudioAsset\n  Asset &lt;|-- GraphicAsset\n\n  Project \&quot;1\&quot; *-- \&quot;many\&quot; Folder : contains\n  FolderType \&quot;1\&quot; -- \&quot;many\&quot; Folder : classifies\n  Folder \&quot;1\&quot; *-- \&quot;many\&quot; Asset : contains\n\n  Project \&quot;1\&quot; o-- \&quot;many\&quot; AudioTrack : has\n  Project \&quot;1\&quot; *-- \&quot;many\&quot; PhaseProgress : tracks\n  Phase \&quot;1\&quot; -- \&quot;many\&quot; PhaseProgress : defines\n  PhaseProgress \&quot;1\&quot; *-- \&quot;many\&quot; ChecklistItem : contains\n  ChecklistCategory \&quot;1\&quot; -- \&quot;many\&quot; ChecklistItem : classifies\n\n  Project \&quot;1\&quot; *-- \&quot;many\&quot; Export : produces\n  ExportPreset \&quot;1\&quot; -- \&quot;many\&quot; Export : used in\n  Platform \&quot;1\&quot; -- \&quot;many\&quot; ExportPreset : classifies\n\n  Project \&quot;1\&quot; -- \&quot;many\&quot; ProjectMember : includes\n  User \&quot;1\&quot; -- \&quot;many\&quot; ProjectMember : has&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="2">
