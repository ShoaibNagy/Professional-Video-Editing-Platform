        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n  USER ||--o{ PROJECT_MEMBER : has\n  PROJECT ||--o{ PROJECT_MEMBER : includes\n  PROJECT ||--o{ PHASE_PROGRESS : tracks\n  PHASE ||--o{ PHASE_PROGRESS : defines\n  PHASE_PROGRESS ||--o{ CHECKLIST_ITEM : contains\n  CHECKLIST_CATEGORY ||--o{ CHECKLIST_ITEM : classifies\n  PROJECT ||--o{ FOLDER : has\n  FOLDER_TYPE ||--o{ FOLDER : classifies\n  FOLDER ||--o{ ASSET : contains\n  PROJECT ||--o{ AUDIO_TRACK : has\n  PROJECT ||--o{ EXPORT : produces\n  PLATFORM ||--o{ EXPORT_PRESET : classifies\n  EXPORT_PRESET ||--o{ EXPORT : \&quot;used in\&quot;\n\n  USER {\n    string id PK\n    string name\n    string email\n    string role\n  }\n  PROJECT {\n    string id PK\n    string name\n    string created_date\n    string status\n  }\n  PROJECT_MEMBER {\n    string id PK\n    string project_id FK\n    string user_id FK\n    string role\n  }\n  PHASE {\n    string id PK\n    string name\n    int order_index\n  }\n  PHASE_PROGRESS {\n    string id PK\n    string project_id FK\n    string phase_id FK\n    string status\n    string started_at\n    string completed_at\n  }\n  CHECKLIST_CATEGORY {\n    string id PK\n    string name\n  }\n  CHECKLIST_ITEM {\n    string id PK\n    string phase_progress_id FK\n    string category_id FK\n    string description\n    boolean is_complete\n  }\n  FOLDER_TYPE {\n    string id PK\n    string name\n  }\n  FOLDER {\n    string id PK\n    string project_id FK\n    string folder_type_id FK\n    string path\n  }\n  ASSET {\n    string id PK\n    string folder_id FK\n    string filename\n    int rating\n    string version\n    string date_added\n  }\n  AUDIO_TRACK {\n    string id PK\n    string project_id FK\n    string track_type\n    boolean levels_ok\n  }\n  PLATFORM {\n    string id PK\n    string name\n  }\n  EXPORT_PRESET {\n    string id PK\n    string platform_id FK\n    string resolution\n    string framerate\n    string codec\n  }\n  EXPORT {\n    string id PK\n    string project_id FK\n    string preset_id FK\n    string export_date\n    string file_path\n  }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="2">
